{
  "name": "Threadwise",
  "short_name": "Threadwise",
  "description": "Peer-to-peer messaging designed for neurodivergent minds",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f0f14",
  "theme_color": "#0f0f14",
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "scope": "/",
  "id": "/",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "screenshots": [
    { "src": "screenshots/mobile.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Threadwise inbox" },
    { "src": "screenshots/mobile.png", "sizes": "390x844", "type": "image/png", "form_factor": "wide", "label": "Threadwise inbox" }
  ],
  "shortcuts": [
    { "name": "New Conversation", "short_name": "New Chat", "url": "/?action=new-conversation", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/?share-target",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "tab_strip": {"home_tab": {"icons": [{"src": "/icons/icon-192.png", "sizes": "192x192"}]}, "new_tab_button": {"url": "/?new-tab"}},
  "launch_handler": { "client_mode": "focus-existing" },
  "display_override": ["tabbed", "window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "scope_extensions": [{ "origin": "https://threadwise-8b8f5.web.app" }],
  "file_handlers": [
    { "action": "/", "accept": { "text/plain": [".txt"], "image/png": [".png"], "image/jpeg": [".jpg", ".jpeg"] } }
  ],
  "protocol_handlers": [
    { "protocol": "web+threadwise", "url": "/?protocol=%s" },
    { "protocol": "mailto", "url": "/?mailto=%s" }
  ],
  "widgets": [{"name": "Threadwise", "tag": "threadwise-widget", "url": "/widgets/widget.json", "multiple": false}],
  "edge_side_panel": { "preferred_width": 400 },
  "related_applications": [{ "platform": "webapp", "url": "https://threadwise-8b8f5.web.app/manifest.json" }],
  "prefer_related_applications": false,
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "categories": ["social", "communication"]
}
